# Backend API connection
SETTLEMENT_API_URL=http://127.0.0.1:8787
SETTLEMENT_API_KEY=replace-with-your-settlement-api-key

# Set to true to broadcast real transactions (false = simulation only)
SETTLEMENT_LIVE=false

# Optional: restrict to a specific network or pair
# SETTLEMENT_NETWORK=base
# SETTLEMENT_PAIR_ID=0x...

# EVM executor wallet (required when SETTLEMENT_LIVE=true)
SETTLEMENT_EXECUTOR_PRIVATE_KEY=0xreplace-with-your-private-key

# Settlement contracts
SETTLEMENT_CONTRACT=0x4896ebe3EE1436a58c690A8021301A6bFD6BD4E7
BASE_SETTLEMENT_CONTRACT=0x52DB65cD75Cf7b0094e11A8642F6A104fa7C1554
ROBINHOOD_SETTLEMENT_CONTRACT=0x04569d1d2D4bec54bb1D55a6Bd7589aD996BbeDC

# EVM RPC endpoints
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_RPC_URLS=https://bsc-rpc.publicnode.com,https://bsc.blockrazor.xyz,https://bsc-dataseed.binance.org
BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_URLS=https://mainnet.base.org,https://base.llamarpc.com,https://base-rpc.publicnode.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URLS=https://rpc.mainnet.chain.robinhood.com

# Solana executor wallet (base58 private key)
SOLANA_EXECUTOR_PRIVATE_KEY=replace-with-base58-solana-private-key
VITE_SOLANA_EXECUTOR_ADDRESS=replace-with-solana-executor-public-key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com

# Polling config
SETTLEMENT_POLL_MS=3000
SETTLEMENT_POLL_LIMIT=50
ALLOW_MAINNET_LIVE=true

# Safety: set to true to run exactly once then exit
SETTLEMENT_ONCE=false
